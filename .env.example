# Which vision model grades bin photos: gemini | anthropic | mock
GRADER_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ElevenLabs (voice reports + warden briefing)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_AGENT_ID=

# Render Workflows (optional). If set, the API hands grading to the workflow
# service instead of grading inline.
RENDER_API_KEY=
RENDER_WORKFLOW_SLUG=

# Storage
DATA_DIR=./data
