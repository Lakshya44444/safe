# ---- LLM gateway ----
# Primary grader: gemini | anthropic | mock | replay
GRADER_PROVIDER=mock
# Tried in order if the primary fails, e.g. "anthropic" or "anthropic,mock"
LLM_FALLBACKS=
LLM_MAX_RETRIES=2
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- LangSmith (optional tracing + eval experiments) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kachra-report-card

# ---- ElevenLabs ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_AGENT_ID=

# ---- Render Workflows (optional) ----
RENDER_API_KEY=
RENDER_WORKFLOW_SLUG=

# ---- Storage and demo ----
DATA_DIR=./data
SEED_DEMO=1
KG_PER_WET_BIN=12
LOG_LEVEL=INFO
